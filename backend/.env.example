# Copy to backend/.env and adjust. Every value is optional for local use.
# NEVER put real secrets in this example file.

# --- Core --------------------------------------------------------------------
# Where the database, uploads and generated keys live. Default: %LOCALAPPDATA%\Ledgerly
# (kept outside the OneDrive-synced source folder on purpose).
DATA_DIR=
# Default: SQLite inside DATA_DIR. PostgreSQL example (needs: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://ledgerly:ledgerly@localhost:5432/ledgerly
DATABASE_URL=
APP_URL=http://localhost:5173
# Generated and stored in DATA_DIR when empty. Set explicitly in production.
SECRET_KEY=
ENCRYPTION_KEY=
ALLOW_REGISTRATION=false
SESSION_DAYS=14
AUTO_MIGRATE=true
MAX_UPLOAD_MB=10
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Email (optional) ---------------------------------------------------------
# Local testing with Mailpit (free): SMTP_HOST=localhost SMTP_PORT=1025, inbox at http://localhost:8025
# Empty SMTP_HOST = emails are only written to the server log (status "logged").
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ledgerly <ledgerly@localhost>
SMTP_STARTTLS=false

# --- SMS / WhatsApp (optional, mock by default – see docs/costs.md) ------------
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# --- Bank provider: RBI Account Aggregator via Setu (not implemented yet) -------
# Requires FIU registration. See docs/bank-integration.md.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_ENV=sandbox
