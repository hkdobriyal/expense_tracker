# Hisaab – local configuration. This file is git-ignored: keep real passwords here, never in .env.example.
# After editing, restart the API and the worker.

APP_NAME=Hisaab
APP_URL=http://localhost:5173
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
DEFAULT_TIMEZONE=Asia/Kolkata
# DATA_DIR=            (default: %LOCALAPPDATA%\Hisaab – outside OneDrive)

# ----------------------------------------------------------------------------
# EMAIL (SMTP) – replace the dummy values below with your real ones.
# While these still contain "your-…" the app treats email as NOT configured and
# only writes emails (incl. password-reset links) to the API console log.
#
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#          SMTP_USER=you@gmail.com   SMTP_PASSWORD=<16-character App Password>
#          (Google Account → Security → 2-Step Verification → App passwords.
#           Your normal Gmail password will NOT work.)
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
# Local test inbox (Mailpit): SMTP_HOST=localhost  SMTP_PORT=1025  (leave user/password empty)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Hisaab <your-email@gmail.com>
# STARTTLS is used automatically on port 587, SSL on 465. Override if needed:
# SMTP_STARTTLS=true
# SMTP_SSL=false

# ----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push) – works out of the box, nothing to fill in.
# The VAPID key pair is generated automatically into the data folder.
# Push works on http://localhost; any other address needs HTTPS.
# ----------------------------------------------------------------------------
VAPID_SUBJECT=mailto:your-email@gmail.com

# ----------------------------------------------------------------------------
# AI (all free & local). ML categorisation and OCR need nothing extra.
# Optional local LLM: install Ollama (https://ollama.com), then run
#   ollama pull qwen2.5:3b
# and keep Ollama running. Without it the app uses its built-in rules.
# ----------------------------------------------------------------------------
ML_ENABLED=true
OCR_ENABLED=true
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=       (only for servers that need one)

# SMS / WhatsApp stay mock (paid services in India – see docs/costs.md)
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
